# Copy this file to .env.local and fill in your Supabase project's values.
# Project settings -> API in the Supabase dashboard.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Session timeout (minutes) implementing SRS 0680. Fixed constant for this MVP
# (see docs/assumptions.md, item 2) rather than admin-configurable.
NEXT_PUBLIC_SESSION_TIMEOUT_MINUTES=30
